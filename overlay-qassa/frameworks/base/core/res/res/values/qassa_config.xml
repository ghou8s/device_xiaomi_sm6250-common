<resources>
    <!-- Whether to use old mobile type icons as default -->
    <bool name="config_useOldMobileIcons">true</bool>

    <!-- Wheter device supports an gaming mode profiles -->
    <bool name="config_gamingmode_performance">true</bool>

    <!-- Gaming Mode FPSInfoService FPS node file path -->
    <string name="config_gamingmode_fpsInfoSysNode" translatable="false">/sys/class/drm/card0/sde-crtc-0/measured_fps</string>

    <!-- Whether device has a physical display cutout -->
    <bool name="config_physicalDisplayCutout">true</bool>

</resources>
